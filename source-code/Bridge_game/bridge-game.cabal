name:                bridge-game
version:             0.1.0.0
synopsis:            Rubber Bridge game with heuristic AI and text interface
description:         A decoupled implementation of contract rubber bridge in Haskell
license:             Apache-2.0
license-file:        ../APACHE_LICENSE-2.0.txt
author:              Mark Watson
maintainer:          markw@markwatson.com
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Bridge.Types
                     , Bridge.Cards
                     , Bridge.Bidding
                     , Bridge.Play
                     , Bridge.Scoring
                     , Bridge.Engine
  build-depends:       base >= 4.7 && < 5
                     , containers >= 0.6
                     , random >= 1.1
                     , aeson >= 1.0
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall

test-suite bridge-game-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test
  build-depends:       base
                     , containers
                     , bridge-game
                     , hspec
  default-language:    Haskell2010

executable bridge-game
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base
                     , containers
                     , random
                     , aeson
                     , bridge-game
  default-language:    Haskell2010
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
