cabal-version: 3.0
name:          symbolic-math
version:       0.1.0.0
synopsis:      Symbolic mathematics library for Haskell
description:   A foundational library for symbolic mathematics in Haskell.
  Provides data structures for variables, terms, polynomials, and integrals,
  along with symbolic differentiation and integration.
  Ported from the Common Lisp symbolic-math library.
license:       MIT
author:        Mark Watson
build-type:    Simple

common common-opts
  default-language: GHC2021
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules
    -Wpartial-fields -Wredundant-constraints

library
  import:          common-opts
  hs-source-dirs:  src
  exposed-modules:
    SymbolicMath.Types
    SymbolicMath.Differentiation
    SymbolicMath.Integration
  build-depends:
    base       >= 4.16,
    containers

test-suite symbolic-math-test
  import:         common-opts
  type:            exitcode-stdio-1.0
  main-is:         Spec.hs
  hs-source-dirs:  test
  build-depends:
    base,
    symbolic-math,
    hspec
  default-language: GHC2021

executable symbolic-math
  import:         common-opts
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    symbolic-math
