cabal-version:      2.4
name:              gemini
version:           0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Bard
maintainer:         Bard
build-type:          Simple
extra-source-files:  CHANGELOG.md

library
  exposed-modules:     Gemini
  build-depends:       base >= 4.7 && < 5
                     , aeson
                     , text
  default-language:    Haskell2010
  default-extensions:
    OverloadedStrings
    DeriveGeneric

executable gemini
  main-is:             Main.hs
  other-modules:       Gemini
  build-depends:       base >= 4.7 && < 5
                     , aeson
                     , bytestring
                     , text
                     , http-client
                     , http-client-tls
                     , http-types
                     , directory
                     , vector
                     , gemini
  if os(darwin)
      ghc-options:
      ld-options:

  default-extensions:
    OverloadedStrings
    DeriveGeneric
    LambdaCase
    DeriveAnyClass

  ghc-options: -Wall -O2

test-suite gemini-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test
  build-depends:       base
                     , gemini
                     , aeson
                     , bytestring
                     , hspec
  default-language:    Haskell2010
  default-extensions:
    OverloadedStrings
    DeriveGeneric
