-- cabal.project
-- Originally used a Git source-repository-package for dataframe 1.0.0.0,
-- but the main branch has moved to v3 which requires sub-packages not on
-- Hackage. Use Hackage versions instead (1.3 – 2.3 available).

packages: .

          
allow-newer:
    pinch:containers,
    pinch:bytestring,
    bytestring-lexing:base
