cabal-version:      3.0
name:               go-game
version:            1.0.0
synopsis:           Terminal-based Go game with AI opponent
description:        A full-featured Go (board game) program with multiple AI engines:
                    tactical analysis, strategic evaluation, joseki patterns, and
                    Monte Carlo Tree Search (MCTS). Play against the AI in the terminal.
license:            MIT
build-type:         Simple

executable go-game
  default-language: Haskell2010
  hs-source-dirs:   src
  main-is:          Main.hs
  other-modules:    Board
                  , Tactical
                  , Strategic
                  , Joseki
                  , MCTS
                  , Agent
                  , Rules
  build-depends:    base >= 4.14 && < 5
                  , vector >= 0.12
                  , random >= 1.2
                  , time >= 1.9
                  , containers >= 0.6
  ghc-options:      -O2 -Wall -threaded
