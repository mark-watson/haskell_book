name:                ollama-client
version:             0.1.0.0
synopsis:            A simple client for Ollama API
description:         A Haskell client to interact with local Ollama API
license:             MIT
author:              Your Name
maintainer:          your.email@example.com
category:            AI
build-type:          Simple
cabal-version:       >=1.10

executable ollama-client
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:
    base >= 4.7 && < 5,
    aeson,
    bytestring,
    http-client,
    text,
    http-types,
    vector,
    optparse-applicative

  -- Language extensions used in the code
  default-extensions:
    OverloadedStrings
    DeriveGeneric
    LambdaCase
    DeriveAnyClass

  -- Compiler flags
  ghc-options: -Wall -O2
