name:                ollama-client
version:             0.1.0.0
synopsis:            A simple client for Ollama API
description:         A Haskell client to interact with local Ollama API
license:             MIT
author:              Your Name
maintainer:          your.email@example.com
category:            AI
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Ollama
  build-depends:       base >= 4.7 && < 5
                     , aeson
                     , bytestring
                     , text
  default-language:    Haskell2010
  default-extensions:
    OverloadedStrings
    DeriveGeneric
    DeriveAnyClass

executable ollama-client
  main-is:             Main.hs
  other-modules:       Ollama
  build-depends:
    base >= 4.7 && < 5,
    aeson,
    bytestring,
    http-client,
    text,
    http-types,
    vector,
    optparse-applicative,
    ollama-client
  default-language:    Haskell2010
  default-extensions:
    OverloadedStrings
    DeriveGeneric
    DeriveAnyClass
  ghc-options: -Wall -O2

test-suite ollama-client-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test
  build-depends:       base
                     , ollama-client
                     , aeson
                     , bytestring
                     , hspec
  default-language:    Haskell2010
