cabal-version:       2.4
name:                webkit-haskell
version:             0.1.0.0
synopsis:            Lightweight Haskell framework for native macOS desktop apps using WebKit (WKWebView)
description:         Port of webkit-rust to Haskell, providing bidirectional JS-to-Haskell FFI bridge.
license:             Apache-2.0
license-file:        ../APACHE_LICENSE-2.0.txt
author:              Mark Watson
maintainer:          markw@markwatson.com
build-type:          Simple

library
  exposed-modules:     WebKitHaskell
  build-depends:       base >= 4.7 && < 5
                     , aeson >= 1.0
                     , bytestring >= 0.10
                     , containers >= 0.6
                     , directory >= 1.3
                     , filepath >= 1.4
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall
  
  if os(darwin)
    c-sources:         cbits/webkit_haskell.m
    include-dirs:      cbits
    cc-options:        -fobjc-arc
    frameworks:        Cocoa WebKit

executable webkit-hello-world
  main-is:             HelloWorld.hs
  hs-source-dirs:      examples
  build-depends:       base
                     , webkit-haskell
  default-language:    Haskell2010
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N

executable webkit-counter-app
  main-is:             CounterApp.hs
  hs-source-dirs:      examples
  build-depends:       base
                     , aeson
                     , webkit-haskell
  default-language:    Haskell2010
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N

executable webkit-markdown-viewer
  main-is:             MarkdownViewer.hs
  hs-source-dirs:      examples
  build-depends:       base
                     , aeson
                     , directory
                     , filepath
                     , webkit-haskell
  default-language:    Haskell2010
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N

test-suite webkit-haskell-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test
  build-depends:       base
                     , webkit-haskell
                     , hspec
  default-language:    Haskell2010
  ghc-options:         -Wall
