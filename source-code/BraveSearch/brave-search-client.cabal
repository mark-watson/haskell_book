name:                brave-search-client
version:             0.1.0.0
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     BraveSearch
  build-depends:       base >= 4.7 && < 5
                     , http-conduit
                     , aeson
                     , text
                     , bytestring
                     , http-client
  default-language:    Haskell2010

executable brave-search-client
  main-is:             Main.hs
  build-depends:       base >= 4.7 && < 5
                     , brave-search-client
  default-language:    Haskell2010

test-suite brave-search-client-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test
  build-depends:       base
                     , brave-search-client
                     , aeson
                     , text
                     , bytestring
                     , hspec
  default-language:    Haskell2010
